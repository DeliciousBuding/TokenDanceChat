CHAT_ADDR=:8080
CHAT_DB_PATH=data/chat.db
CHAT_FRONTEND_DIR=frontend/dist
# Optional: set to "*" for all origins, or a comma-separated list of allowed domains.
# CHAT_ALLOWED_ORIGINS=chat.example.com,.example.com

# App session signing. Set a stable random value in shared/persistent deployments.
# If unset, the server uses an ephemeral per-process secret and existing sessions fail after restart.
CHAT_SESSION_SECRET=

# Assistant identities.
CHAT_BOT_NAME=TokenBot
CHAT_AGENT_NAME=PicoClaw

# LLM adapter for TokenBot and PicoClaw (OpenAI-compatible API).
# Supports DeepSeek, OpenAI, Anthropic, and any /v1/chat/completions endpoint.
CHAT_LLM_PROVIDER=openai
# DeepSeek: https://api.deepseek.com
# OpenAI: https://api.openai.com
CHAT_LLM_BASE_URL=https://api.deepseek.com
# DeepSeek V4 series:
#   deepseek-v4-pro   — flagship reasoning model
#   deepseek-v4-flash — fast/cheap model
CHAT_LLM_MODEL=deepseek-v4-pro
CHAT_LLM_API_KEY=
CHAT_LLM_MAX_TOKENS=8192
CHAT_LLM_MEMORY_SIZE=20
# Optional: persist bot memory to a Markdown file for continuity across restarts.
# CHAT_LLM_MEMORY_PATH=data/bot_memory.md

# Optional PicoClaw agent gateway. Prefer Bearer token auth over query token.
CHAT_PICOCLAW_URL=ws://127.0.0.1:18790/pico/ws
CHAT_PICOCLAW_TOKEN=

# Optional remote media storage. If unset, uploads use CHAT_DB_PATH directory/uploads.
# S3-compatible storage has precedence over WebDAV and is the preferred production shape.
# Keep endpoint, bucket, access key, and secret key in private env files only.
CHAT_MEDIA_S3_ENDPOINT=https://s3.example.com
CHAT_MEDIA_S3_REGION=auto
CHAT_MEDIA_S3_BUCKET=tokendancechat-media
CHAT_MEDIA_S3_ACCESS_KEY_ID=
CHAT_MEDIA_S3_SECRET_ACCESS_KEY=
CHAT_MEDIA_S3_SESSION_TOKEN=
CHAT_MEDIA_S3_PREFIX=uploads
# Set true for MinIO/R2-like path-style endpoints when required.
CHAT_MEDIA_S3_FORCE_PATH_STYLE=false

# Legacy fallback: WebDAV media storage.
CHAT_MEDIA_WEBDAV_ENDPOINT=https://your-webdav.example.com
CHAT_MEDIA_WEBDAV_USER=your-username
CHAT_MEDIA_WEBDAV_PASS=

# TokenDance ID OIDC integration (https://id.vectorcontrol.tech).
# Set CHAT_OIDC_ENABLED=true to enable the "Login with TokenDance ID" button and OIDC routes.
# To get a client_id, register an OAuth App at https://id.vectorcontrol.tech:
#   Dashboard -> Apps -> New App -> client_id (c_xxx) + client_secret (cs_xxx)
CHAT_OIDC_ENABLED=false
CHAT_OIDC_ISSUER=https://id.vectorcontrol.tech
# IMPORTANT: Replace tokendance-chat with your real client_id from the OAuth App dashboard.
CHAT_OIDC_CLIENT_ID=tokendance-chat
# Dev redirect URI (localhost). For production, use: https://chat.vectorcontrol.tech/api/oidc/callback
CHAT_OIDC_REDIRECT_URI=http://localhost:8080/api/oidc/callback
# TODO: CHAT_OIDC_CLIENT_SECRET env var will be needed if the provider requires client_secret at the token endpoint.
