CHAT_ADDR=:8080
CHAT_DB_PATH=data/chat.db
CHAT_FRONTEND_DIR=frontend/dist
# Optional: set to "*" for all origins, or a comma-separated list of allowed domains.
# CHAT_ALLOWED_ORIGINS=chat.example.com,.example.com

# Assistant identities.
CHAT_BOT_NAME=TokenBot
CHAT_AGENT_NAME=PicoClaw

# Optional normal bot LLM adapter.
CHAT_LLM_PROVIDER=openai
CHAT_LLM_BASE_URL=https://your-llm-proxy.example.com
CHAT_LLM_MODEL=deepseek-v4-flash
CHAT_LLM_API_KEY=
CHAT_LLM_MAX_TOKENS=8192
CHAT_LLM_MEMORY_SIZE=20
# Optional: persist bot memory to a Markdown file for continuity across restarts.
# CHAT_LLM_MEMORY_PATH=data/bot_memory.md

# Optional PicoClaw agent gateway. Prefer Bearer token auth over query token.
CHAT_PICOCLAW_URL=ws://127.0.0.1:18790/pico/ws
CHAT_PICOCLAW_TOKEN=

# Optional remote media storage. If unset, uploads use CHAT_DB_PATH directory/uploads.
# S3-compatible storage has precedence over WebDAV and is the preferred production-server shape.
# Keep endpoint, bucket, access key, and secret key in private env files only.
CHAT_MEDIA_S3_ENDPOINT=https://s3.example.com
CHAT_MEDIA_S3_REGION=auto
CHAT_MEDIA_S3_BUCKET=tokendancechat-media
CHAT_MEDIA_S3_ACCESS_KEY_ID=
CHAT_MEDIA_S3_SECRET_ACCESS_KEY=
CHAT_MEDIA_S3_SESSION_TOKEN=
CHAT_MEDIA_S3_PREFIX=uploads
# Set true for MinIO/R2-like path-style endpoints when required.
CHAT_MEDIA_S3_FORCE_PATH_STYLE=false

# Legacy fallback: WebDAV media storage.
CHAT_MEDIA_WEBDAV_ENDPOINT=https://your-webdav.example.com
CHAT_MEDIA_WEBDAV_USER=your-username
CHAT_MEDIA_WEBDAV_PASS=
