CHAT_ADDR=:8080
CHAT_DB_PATH=data/chat.db
CHAT_FRONTEND_DIR=frontend/dist
# Optional: comma-separated list of exact browser origins. Use explicit scheme.
# Subdomain wildcards must also include a scheme. "*" is rejected for cross-origin requests.
# CHAT_ALLOWED_ORIGINS=https://chat.example.com,https://*.example.com
# Optional: trusted reverse proxy CIDRs whose X-Forwarded-For / X-Real-IP headers may drive rate limits.
# For local nginx on the same host, 127.0.0.1/32 is typical. Leave empty when directly exposed.
# CHAT_TRUSTED_PROXY_CIDRS=127.0.0.1/32

# App session signing. Set a stable random value in shared/persistent deployments.
# If unset, the server uses an ephemeral per-process secret and existing sessions fail after restart.
CHAT_SESSION_SECRET=

# Assistant identity.
CHAT_BOT_NAME=TokenBot

# LLM adapter for TokenBot (OpenAI-compatible API).
# Supports DeepSeek, OpenAI, Anthropic, and any /v1/chat/completions endpoint.
CHAT_LLM_PROVIDER=openai
# TokenDance Gateway (production): https://api.tokendancelab.com/v1
# DeepSeek: https://api.deepseek.com
# OpenAI: https://api.openai.com
CHAT_LLM_BASE_URL=https://api.tokendancelab.com/v1
# Primary production model (reasoning):
#   deepseek-v4-flash-vision-exp
# Other DeepSeek V4 series:
#   deepseek-v4-pro   — flagship reasoning model
#   deepseek-v4-flash — fast/cheap model
CHAT_LLM_MODEL=deepseek-v4-flash-vision-exp
CHAT_LLM_API_KEY=
CHAT_LLM_MAX_TOKENS=8192
CHAT_LLM_MEMORY_SIZE=20
# Optional: persist bot memory to a Markdown file for continuity across restarts.
# CHAT_LLM_MEMORY_PATH=data/bot_memory.md

# TokenDance ID OIDC integration.
# Set CHAT_OIDC_ENABLED=true to enable the "Login with TokenDance ID" button and OIDC routes.
# To get a client_id, register an OAuth app with the target identity provider.
CHAT_OIDC_ENABLED=false
CHAT_OIDC_ISSUER=https://id.example.com
# IMPORTANT: replace with the real client_id from the OAuth app dashboard.
CHAT_OIDC_CLIENT_ID=
# Dev redirect URI (localhost). For production, use the deployment host callback URL.
CHAT_OIDC_REDIRECT_URI=http://localhost:8080/api/oidc/callback
# Optional: confidential-client secret. Set to send client_secret at the token
# and refresh endpoints; leave empty for a PKCE public client (code_verifier only).
# CHAT_OIDC_CLIENT_SECRET=
